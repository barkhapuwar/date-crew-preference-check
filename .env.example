# Optional. Without a key the tagger falls back to a keyword matcher, so the demo still works.
# Get a free key at https://aistudio.google.com/apikey and put it in .env.local (never commit it).
GEMINI_API_KEY=
# Optional. Model names change; check Google AI Studio for what is currently available on your account.
# If this model fails, the app tries gemini-3.5-flash-lite and then gemini-3.5-flash before falling back to keywords.
GEMINI_MODEL=gemini-3.5-flash-lite
